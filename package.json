{
  "name": "MingYunTime",
  "version": "3.0.0",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaomingky/MingYunTime"
  },
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=256 && vite",
    "dev:light": "set NODE_OPTIONS=--max-old-space-size=192 && vite",
    "build": "node scripts/ensure-qq-music-dist.cjs && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.0",
    "@applemusic-like-lyrics/lyric": "^1.0.0",
    "@applemusic-like-lyrics/vue": "^0.5.0",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@sansenjian/qq-music-api": "^2.4.0",
    "axios": "^1.13.6",
    "cheerio": "^0.22.0",
    "electron-updater": "^6.8.3",
    "flac-metadata": "^0.1.1",
    "flv.js": "^1.6.2",
    "hls.js": "^1.6.16",
    "iconv-lite": "^0.6.3",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lucide-vue-next": "^0.446.0",
    "mpegts.js": "^1.8.0",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.1",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-node-polyfills": "^0.27.0"
  },
  "build": {
    "appId": "com.mingyuntime.app",
    "productName": "茗韵时光",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "public",
      "package.json"
    ],
    "extraResources": [
      "font/**",
      {
        "from": "resources/aria2c.exe",
        "to": "aria2c.exe"
      },
      {
        "from": "resources/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "resources/qq-music-api/dist",
        "to": "qq-music-api/dist"
      },
      {
        "from": "resources/qq-music-api/libs",
        "to": "qq-music-api/libs"
      },
      {
        "from": "resources/qq-music-api/package.json",
        "to": "qq-music-api/package.json"
      },
      {
        "from": "electron/qq-styletext-polyfill.cjs",
        "to": "qq-styletext-polyfill.cjs"
      }
    ],
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "FLAC 无损音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "ogg",
        "name": "OGG 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "m4a",
        "name": "M4A 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "ape",
        "name": "APE 无损音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "aac",
        "name": "AAC 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "wma",
        "name": "WMA 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "opus",
        "name": "OPUS 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "MP4 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "MKV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WEBM 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "AVI 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "MOV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "flv",
        "name": "FLV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "wmv",
        "name": "WMV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "m4v",
        "name": "M4V 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "ts",
        "name": "TS 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName} Setup ${version}.${ext}",
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "茗韵时光",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "installerIcon": "build/icon.ico",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "displayLanguageSelector": false
    }
  }
}
