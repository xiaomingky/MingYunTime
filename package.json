{
  "name": "MingYunTime",
  "version": "4.0.1",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaomingky/MingYunTime"
  },
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=1024 && vite",
    "dev:light": "set NODE_OPTIONS=--max-old-space-size=512 && vite",
    "build": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& set electron_config_cache=%cd%\\.eb-cache&& node scripts/clean-dist.cjs && node scripts/ensure-qishui-runtime.cjs && vite build && electron-builder",
    "preview": "vite preview",
    "check:electron": "electron scripts/check-electron-functional.cjs",
    "check:music": "node scripts/check-music-platforms.mjs",
    "check:music:live": "node scripts/check-music-platforms.mjs --live",
    "check:qishui:electron": "electron scripts/check-qishui-electron.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "check": "node scripts/check-modernization.mjs && node scripts/check-player-queue.mjs && node scripts/check-playback-start.mjs && node scripts/check-playlist-comments.mjs && node scripts/check-qishui-cenc.mjs && node scripts/check-download-stream.mjs && node scripts/check-download-resolver.mjs && node scripts/check-download-center.mjs && node scripts/check-qishui-playlists.mjs && node scripts/check-song-vip.mjs && node scripts/check-qq-search.mjs && node scripts/check-douyu-live.mjs && node scripts/check-apple-lyrics.mjs && node scripts/check-douyin-media.mjs && node scripts/check-douyin-browser.mjs && node scripts/check-interface-motion.mjs && node scripts/check-music-platforms.mjs && node scripts/check-qq-client.mjs && node scripts/check-qq-native-login.mjs && node scripts/check-qq-inline-qr.mjs && node scripts/check-qq-benefits.mjs && node scripts/check-esports-scoreboard.mjs && node scripts/check-qishui-search-login.mjs && node scripts/check-qishui-business.mjs && node scripts/check-qishui-account.mjs && node scripts/check-netease-client.mjs && node scripts/check-kugou-client.mjs && node scripts/check-account-state.mjs && node scripts/check-membership-state.mjs && node scripts/check-update-version.mjs && node scripts/check-platform-fixes.mjs && node scripts/check-stream-quality.mjs && node scripts/check-netease-playback.mjs && node scripts/check-session-download.mjs && node scripts/check-provider-download.mjs && node scripts/check-api-migration.mjs",
    "check:esports:scoreboard": "node scripts/check-esports-scoreboard.mjs",
    "check:qishui:search-login": "node scripts/check-qishui-search-login.mjs",
    "prepare:qishui": "node scripts/ensure-qishui-runtime.cjs",
    "check:qishui:business": "node scripts/check-qishui-business.mjs",
    "check:qishui:account": "node scripts/check-qishui-account.mjs",
    "check:qq:client": "node scripts/check-qq-client.mjs",
    "check:qq:benefits": "node scripts/check-qq-benefits.mjs",
    "check:qq:electron": "electron scripts/check-qq-electron.cjs",
    "check:qq:login": "electron scripts/check-qq-login.cjs",
    "check:netease:client": "node scripts/check-netease-client.mjs",
    "check:netease:electron": "electron scripts/check-netease-electron.cjs",
    "check:kugou:client": "node scripts/check-kugou-client.mjs",
    "check:account:state": "node scripts/check-account-state.mjs",
    "check:kugou:electron": "electron scripts/check-kugou-electron.cjs",
    "check:playback:start": "node scripts/check-playback-start.mjs",
    "check:platform:fixes": "node scripts/check-platform-fixes.mjs",
    "check:qishui:cenc": "node scripts/check-qishui-cenc.mjs",
    "check:stream:quality": "node scripts/check-stream-quality.mjs",
    "check:qq:native-login": "node scripts/check-qq-native-login.mjs",
    "check:api:migration": "node scripts/check-api-migration.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.0",
    "@applemusic-like-lyrics/lyric": "^1.0.0",
    "@applemusic-like-lyrics/vue": "^0.5.0",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "artplayer": "^5.4.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "axios": "^1.13.6",
    "cheerio": "^0.22.0",
    "electron-updater": "^6.8.3",
    "flac-metadata": "^0.1.1",
    "flv.js": "^1.6.2",
    "hls.js": "^1.6.16",
    "iconv-lite": "^0.6.3",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lucide-vue-next": "^0.446.0",
    "mpegts.js": "^1.8.0",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.1",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-node-polyfills": "^0.27.0"
  },
  "build": {
    "appId": "com.mingyuntime.app",
    "productName": "茗韵时光",
    "compression": "maximum",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "public",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/aria2c.exe",
        "to": "aria2c.exe"
      },
      {
        "from": "resources/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "resources/yt-dlp.exe",
        "to": "yt-dlp.exe"
      },
      {
        "from": "electron/qishui-runtime-worker.cjs",
        "to": "qishui-runtime-worker.cjs"
      },
      {
        "from": "resources/qishui-runtime",
        "to": "qishui-runtime"
      }
    ],
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "FLAC 无损音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "ogg",
        "name": "OGG 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "m4a",
        "name": "M4A 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "ape",
        "name": "APE 无损音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "aac",
        "name": "AAC 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "wma",
        "name": "WMA 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "opus",
        "name": "OPUS 音频",
        "description": "茗韵时光音频文件",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "MP4 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "MKV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WEBM 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "AVI 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "MOV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "flv",
        "name": "FLV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "wmv",
        "name": "WMV 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "m4v",
        "name": "M4V 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      },
      {
        "ext": "ts",
        "name": "TS 视频",
        "description": "茗韵时光视频文件",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "7z",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName} Setup ${version}.${ext}",
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "茗韵时光",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "displayLanguageSelector": false
    }
  }
}
