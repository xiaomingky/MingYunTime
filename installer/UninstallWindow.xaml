<Window x:Class="MingYunInstaller.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载茗韵时光" Width="430" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="White" SnapsToDevicePixels="True"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Window.Resources>
        <Storyboard x:Key="RingSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="InnerSpin" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.4"/>
        </Storyboard>
    </Window.Resources>
    <Border BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="14" Background="White">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部品牌区 -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Margin="20,16,0,10" Background="#EC4141" Opacity="0.95">
                    <Image x:Name="AppIcon" Width="34" Height="34" Stretch="Uniform" Margin="6"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="卸载 茗韵时光？" FontSize="16" FontWeight="SemiBold" Foreground="#2E2E2E"/>
                    <TextBlock Text="茗韵时光卸载程序" FontSize="11" Foreground="#9A9A9A" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="CloseBtn" Content="✕" Style="{StaticResource IconBtn}"
                        Margin="0,10,16,0" VerticalAlignment="Top" ToolTip="取消并关闭" Click="Cancel_Click"/>
            </Grid>

            <!-- 渐变分隔 -->
            <Border Grid.Row="1" Height="1.5" Margin="24,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00EC4141" Offset="0"/>
                        <GradientStop Color="#66EC4141" Offset="0.5"/>
                        <GradientStop Color="#00EC4141" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 中部 -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="30,10">
                <TextBlock x:Name="DescText" Text="将删除应用文件、桌面与开始菜单快捷方式，并保留你的本地数据？"
                           FontSize="12" Foreground="#777" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" HorizontalAlignment="Center"/>
                <Grid Margin="0,18,0,4" HorizontalAlignment="Center">
                    <Grid Width="84" Height="84">
                        <Path Stroke="#F1F1F1" StrokeThickness="7" StrokeStartLineCap="Round"
                              Data="M 42 4 A 38 38 0 1 1 41.9 4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="RingFill" Stroke="#EC4141" StrokeThickness="7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 42 4 A 38 38 0 1 1 41.9 4"
                              StrokeDashArray="238.8" StrokeDashOffset="238.8"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PctText" Text="" FontSize="16" FontWeight="SemiBold" Foreground="#EC4141"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="InnerSpin" CenterX="26" CenterY="26"/>
                        </Grid.RenderTransform>
                        <Path Stroke="#EC4141" StrokeThickness="3" Opacity="0.5" StrokeStartLineCap="Round"
                              Data="M 26 4 A 22 22 0 0 1 44 18"/>
                    </Grid>
                </Grid>
                <TextBlock x:Name="ProgressText" Text="" FontSize="11.5" Foreground="#888" Margin="0,10,0,0"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 底部 -->
            <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Padding="22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,12,0" Click="Cancel_Click"/>
                    <Button x:Name="UninstallBtn" Content="确认卸载" Style="{StaticResource PrimaryButton}" Width="120" Click="Uninstall_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>