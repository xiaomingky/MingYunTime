<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MingYunInstaller</RootNamespace>
    <AssemblyName>MingYunInstaller</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <!-- Win7-Win11：目标 .NET Framework 4.8（4.8 是 Win7 SP1 起全系可跑的最高版本线） -->
    <AutomaticallyUseReferenceAssemblyPackages>true</AutomaticallyUseReferenceAssemblyPackages>
    <!-- 版本号跟随主应用（发布时手动对齐） -->
    <Version>3.4.5</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.36.0" />
    <!-- dynamic（WScript.Shell COM）需要 -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- 应用配置（内嵌） -->
  <ItemGroup>
    <EmbeddedResource Include="AppConfig.json" />
    <!-- 图标：exe 图标 + XAML Window.Icon 引用 -->
    <Resource Include="icon.ico" />
    <!-- aria2c：线上版下载器（与主应用同款：128 线程、不限速） -->
    <EmbeddedResource Include="aria2c.exe" />
    <!-- 7za：7z 解压（SharpCompress 不支持 electron-builder 的 LZMA2 .7z） -->
    <EmbeddedResource Include="7za.exe" />
  </ItemGroup>

  <!-- 离线版：构建前把 electron-builder 的 7z 包复制为 AppPackage.7z，即自动内嵌；不复制则走线上下载变体 -->
  <ItemGroup>
    <EmbeddedResource Include="AppPackage.7z" Condition="Exists('AppPackage.7z')" />
  </ItemGroup>

  <ItemGroup>
    <!-- 默认无图标；设为独立程序图标时取消注释 -->
  </ItemGroup>

</Project>